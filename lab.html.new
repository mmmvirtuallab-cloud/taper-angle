<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Virtual Lab Simulation</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <link rel="stylesheet" href="css/common.css">
    <link rel="stylesheet" href="css/style.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.4.0/p5.js"></script>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #1a1c2c 0%, #2a3c7d 100%);
            min-height: 100vh;
            position: relative;
            overflow: hidden;
            /* use flex so header takes natural height and lab-window fills remaining space */
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        /* ensure the header container doesn't flex-grow */
        body > .container-fluid:first-of-type {
            flex: 0 0 auto;
        }

        .lab-window {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            /* stretch full available width; use small horizontal gutters */
            width: calc(100% - 48px);
            margin: 0 24px;
            padding: 12px 20px;
            display: flex;
            flex-direction: row;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            /* let flex sizing control vertical fill; allow children to fit */
            flex: 1 1 auto;
            min-height: 0; /* allow flex children to shrink properly */
            overflow: visible;
        }

        #game-container {
            position: relative;
            z-index: 1;
            filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.1));
            flex: 1 1 auto;
            order: 2;
            margin-left: 20px;
            height: 100%;
            min-height: 0;
            overflow: hidden; /* prevent internal scrollbars from game area */
        }

        .steps-panel {
            width: 280px;
            order: 1;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            padding: 14px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            height: auto; /* size to content rather than stretching */
            align-self: flex-start; /* don't stretch to fill lab-window vertically */
        }

        .steps-panel h3 {
            color: #1a1c2c;
            margin-bottom: 20px;
            text-align: center;
            font-size: 1.4rem;
        }

        .steps-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .step {
            background: rgba(255, 255, 255, 0.8);
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            transition: all 0.3s ease;
        }

        .step-content {
            display: flex;
            align-items: center;
            padding: 12px;
            gap: 12px;
        }

        .step-number {
            width: 24px;
            height: 24px;
            background: #1a1c2c;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .step-text {
            font-size: 0.95rem;
            line-height: 1.3;
        }

        .step.active {
            background: linear-gradient(135deg, #4a569d, #1a1c2c);
            color: white;
            transform: scale(1.02);
            box-shadow: 0 4px 12px rgba(26, 28, 44, 0.2);
        }

        .step.active .step-number {
            background: white;
            color: #1a1c2c;
        }

        /* Decorative elements */
        .decoration {
            position: fixed;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            pointer-events: none;
            animation: float 8s infinite ease-in-out;
        }

        .decoration:nth-child(1) {
            width: 300px;
            height: 300px;
            top: -150px;
            left: -150px;
        }

        .decoration:nth-child(2) {
            width: 200px;
            height: 200px;
            bottom: -100px;
            right: -100px;
            animation-delay: -2s;
        }

        .decoration:nth-child(3) {
            width: 150px;
            height: 150px;
            top: 50%;
            right: -75px;
            animation-delay: -4s;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(5deg); }
        }

        canvas {
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }
    </style>
</head>
<body>
    <!-- Decorative background elements -->
    <div class="decoration"></div>
    <div class="decoration"></div>
    <div class="decoration"></div>
    <div class="container-fluid">
        <div class="experiment-header text-center">
            <h1 class="text-white">Measurement Of Taper Angle (Internal)</h1>
        </div>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="experiment.html">Experiment</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="quiz.html">Pre Lab Quiz</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="procedure.html">Procedure</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="lab.html">Lab</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </div>
    <div class="lab-window">
        <div class="steps-panel">
            <h3>Experiment Steps</h3>
            <div class="steps-list">
                <div class="step" data-step="1">
                    <div class="step-content">
                        <span class="step-number">1</span>
                        <span class="step-text">Click the Blue Ball to select and place it</span>
                    </div>
                </div>
                <div class="step" data-step="2">
                    <div class="step-content">
                        <span class="step-number">2</span>
                        <span class="step-text">Measure height for first ball</span>
                    </div>
                </div>
                <div class="step" data-step="3">
                    <div class="step-content">
                        <span class="step-number">3</span>
                        <span class="step-text">Place the second ball by clicking it</span>
                    </div>
                </div>
                <div class="step" data-step="4">
                    <div class="step-content">
                        <span class="step-number">4</span>
                        <span class="step-text">Measure height for second ball</span>
                    </div>
                </div>
            </div>
        </div>
        <div id="game-container" class="animate__animated animate__fadeIn"></div>
    </div>

    <!-- Game scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/objects/ball.js"></script>
    <script src="js/objects/ball2.js"></script>
    <script src="js/objects/funnel.js"></script>
    <script src="js/objects/ruler.js"></script>
    <script src="js/utils/physics.js"></script>
    <script src="js/game.js"></script>
</body>
</html>